{
  "name": "doubleverify-assignment",
  "version": "1.0.0",
  "description": "A simple ATM system with REST API for balance inquiry, withdrawal, and deposit operations",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "dev:watch": "nodemon --exec ts-node src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:watch": "jest --coverage --watch",
    "test:coverage:html": "jest --coverage && start coverage/index.html",
    "test:coverage:analyze": "npm run test:coverage && node scripts/coverage-analysis.js",
    "test:report": "node scripts/test-report.js",
    "test:unit": "jest tests/unit tests/services tests/middleware tests/models",
    "test:integration": "jest tests/integration tests/routes",
    "prebuild": "rimraf dist",
    "postbuild": "echo 'Build completed successfully'",
    "deploy:aws:eb": "eb deploy",
    "deploy:aws:lambda": "serverless deploy",
    "deploy:heroku": "git push heroku main",
    "deploy:docker": "docker build -t atm-system . && docker run -p 3000:3000 atm-system",
    "health:check": "curl -f http://localhost:3000/health || exit 1",
    "lint": "echo 'Linting not configured yet'",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix"
  },
  "keywords": [
    "atm",
    "banking",
    "api",
    "rest",
    "nodejs",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "cors": "^2.8.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/server.ts",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "lcov",
      "json"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "types": [
              "jest",
              "node"
            ]
          }
        }
      ]
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielnachumdev/doubleverify-assignment.git"
  },
  "bugs": {
    "url": "https://github.com/danielnachumdev/doubleverify-assignment/issues"
  },
  "homepage": "https://github.com/danielnachumdev/doubleverify-assignment#readme"
}
